@page
@model SnakeGameApp.Pages.GameRecords.IndexModel
@{
    ViewData["Title"] = "Registros de Juego - Snake Game";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">🐍 Registros de Snake Game</h1>
            
            <div class="mb-3">
                <a asp-page="./Create" class="btn btn-primary">📝 Nuevo Registro</a>
            </div>

            @if (Model.GameRecords.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>🏆 Posición</th>
                                <th>👤 Nickname</th>
                                <th>⭐ Puntaje</th>
                                <th>⏱️ Tiempo (seg)</th>
                                <th>📅 Fecha</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.GameRecords.Count; i++)
                            {
                                var record = Model.GameRecords[i];
                                <tr>
                                    <td>
                                        @if (i == 0)
                                        {
                                            <span class="badge bg-warning text-dark">🥇 #@(i + 1)</span>
                                        }
                                        else if (i == 1)
                                        {
                                            <span class="badge bg-secondary">🥈 #@(i + 1)</span>
                                        }
                                        else if (i == 2)
                                        {
                                            <span class="badge bg-success">🥉 #@(i + 1)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">#@(i + 1)</span>
                                        }
                                    </td>
                                    <td><strong>@record.Nickname</strong></td>
                                    <td><span class="badge bg-success fs-6">@record.Score pts</span></td>
                                    <td>@record.PlayTimeSeconds seg</td>
                                    <td>@record.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <h4>😊 ¡No hay registros aún!</h4>
                    <p>Sé el primero en registrar tu puntaje en Snake Game.</p>
                    <a asp-page="./Create" class="btn btn-primary">Crear primer registro</a>
                </div>
            }
        </div>
    </div>
</div>